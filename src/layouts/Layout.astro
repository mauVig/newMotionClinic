---
import { initGlobalScroll } from "../scripts/scroll.js";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Motion Clinic</title>
    <meta
      name="description"
      content="El Primer Centro Integral en Cirugía Robótica de Cadera y Rodilla de Argentina. Liderado por el Dr. Andrés Anania"
    />
    <link rel="icon" href="/favicon.ico" />

    <!-- Google Analytics -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id={import.meta.env.PUBLIC_ANALYTICS_ID}"
    ></script>
    <script define:vars={{ analyticsId: import.meta.env.PUBLIC_ANALYTICS_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag("js", new Date());
      gtag("config", analyticsId);
    </script>
  </head>

  <body>
    <slot />
  </body>
 <script type="module">
    import { initGlobalScroll } from "/src/scripts/scroll.js";
    initGlobalScroll();
  </script>
</html>
