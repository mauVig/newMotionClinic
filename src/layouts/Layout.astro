---

// Recibimos props desde la página
const {
  title = "Motion Clinic | Centro de Cirugía Robótica en Argentina",
  description = "Cirugía ortopédica y robótica en Argentina con tecnología avanzada, especialistas médicos y atención personalizada.",
  schema = null
} = Astro.props;

---

<!doctype html>
<html lang="es">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />

    {schema && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(schema)}
      />
    )}

    <!-- MATERIAL SYMBOLS ICON FONT -->
    <link 
      rel="stylesheet" 
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:FILL@0..1,wght@100..700,GRAD@-50..200,opsz@20..48" 
    />

    <style>
      .material-symbols-outlined {
        font-variation-settings:
          'FILL' 0,
          'wght' 400,
          'GRAD' 0,
          'opsz' 32;
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }
    </style>
  </head>

  <body>
    <slot />
  </body>

  <script is:inline>
    window.addEventListener("load", () => {
      import("/src/scripts/scroll-init.js").then(m => {
        m.initScrollSystem();
      });
    });
  </script>
</html>
