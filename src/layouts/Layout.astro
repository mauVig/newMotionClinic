<!doctype html>
<html lang='en'>
  <head>
    <script
      async
      src='https://www.googletagmanager.com/gtag/js?id={import.meta.env.PUBLIC_ANALYTICS_ID}'
    ></script>
    <script define:vars={{ analyticsId: import.meta.env.PUBLIC_ANALYTICS_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());

      gtag('config', analyticsId);
    </script>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width' />
    <meta name='generator' content={Astro.generator} />
    <title>Motion clinic</title>
    <meta
      name='description'
      content='El Primer Centro Integral en Cirugía Robótica de Cadera y Rodilla de Argentina. Liderado por el Dr. Andrés Anania'
    />
    <link rel='icon' type='image/png' href='/favicon-96x96.png' sizes='96x96' />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <link rel='shortcut icon' href='/favicon.ico' />
    <link rel='apple-touch-icon' sizes='180x180' href='/apple-touch-icon.png' />
    <link rel='manifest' href='/site.webmanifest' />
  </head>
  <body>
    <slot />
  </body>
  <script>
    import Lenis from "lenis";

    // Initialize Lenis with smoother configuration
    const lenis = new Lenis({
      autoRaf: true,
      duration: 40,
      easing: (t) => t === 1 ? 1 : 1 - Math.pow(2, -10 * t),
    });

    // Optional: Listen for the scroll event
    lenis.on('scroll', (e) => {
      // console.log(e); // Descomenta si necesitas debug
    });

    // Function to stop/start lenis
    function lenis_stop() {
      lenis.stop();
    }

    function lenis_start() {
      lenis.start();
    }

    // Make lenis globally available for other components
    (window as any).lenis = lenis;
    (window as any).lenis_stop = lenis_stop;
    (window as any).lenis_start = lenis_start;
  </script>
</html>
