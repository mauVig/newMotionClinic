---
import { initGlobalScroll } from "../scripts/scroll.js";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Motion Clinic</title>
  </head>

  <body>
    <slot />
    <script is:inline>
    console.log("💥 Layout ejecutándose correctamente en cliente");
  </script>
  </body>
<script is:inline>
  console.log("🧠 Script global embebido en Layout cargó");

  window.addEventListener("DOMContentLoaded", async () => {
    console.log("🌍 DOMContentLoaded disparado");
    try {
      const module = await import("/src/components/scripts/scroll.js"); // ✅ ruta corregida
      console.log("✅ scroll.js importado correctamente", module);
      if (module.initGlobalScroll) {
        module.initGlobalScroll();
        console.log("🚀 initGlobalScroll() ejecutado");
      } else {
        console.warn("⚠️ No se encontró initGlobalScroll");
      }
    } catch (err) {
      console.error("❌ Error al importar scroll.js", err);
    }
  });
</script>

</html>
