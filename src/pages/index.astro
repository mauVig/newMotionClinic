---
import Loading from '@/components/Loading.tsx';
import Layout from '@/layouts/Layout.astro';
import MagneticCursor from "@/components/MagneticCursor.tsx";
import NavBarv2 from '@/components/NavBarv2.astro';
import Welcome from '@/components/Welcome/Welcomev2.astro';
import Objective from '@/components/Objective/Objectivev2.astro';
import Biography from '@/components/Biography/Biography.astro';
import Skills from '@/components/Skills.astro';
import TestifyWrapp from '@/components/testify/TestifyWrapp.astro';
import Footer from '@/components/Footer.astro';
import Experience from '@/components/Experience/Experience.astro';
import Whatsapp from '@/components/Whatsapp.astro';
import CircleVideo from '@/components/CircleVideo/CircleVideo.astro';
---

<Layout>
  <Loading client:only="react" />
  <MagneticCursor client:only="react" />
  <NavBarv2 tab="home" />
  <Welcome />
  <Objective />
  <Experience />
  <CircleVideo />
  <Biography />
  <Skills />
  <TestifyWrapp />
  <Footer contacto="no" />
  <Whatsapp client:load />
</Layout>