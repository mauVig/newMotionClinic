---
import ContactForm from "@/components/Contact";
import Footer from "@/components/Footer";
import NavBar from "@/components/NavBar";
import Layout from "@/layouts/Layout.astro";
import MagneticCursor from "@/components/MagneticCursor.tsx";
---

<Layout title="Contacto Motion Clinic | Cirugía Ortopédica y Robótica de Cadera y Rodilla" description="Contactá a Motion Clinic para consultas sobre cirugía ortopédica y robótica de cadera y rodilla. Equipo médico especializado para acompañarte en cada etapa del tratamiento.">
  <!-- Cursor magnético también en la página de contacto -->
  <MagneticCursor client:only="react" />

  <NavBar client:only tab="contact" />
  <ContactForm client:only />
  <Footer client:only contacto="yes" />
</Layout>
