---
import ContactForm from "@/components/Contact";
import Footer from "@/components/Footer";
import NavBar from "@/components/NavBar";
import Layout from "@/layouts/Layout.astro";
import MagneticCursor from "@/components/MagneticCursor.tsx";
---

<Layout title="Contacto | Motion Clinic" description="Contactá a Motion Clinic para consultar lo que quieras sobre cirugía ortopédica y robótica de cadera y rodilla. ">
  <!-- Cursor magnético también en la página de contacto -->
  <MagneticCursor client:only="react" />

  <NavBar client:only tab="contact" />
  <ContactForm client:only />
  <Footer client:only contacto="yes" />
</Layout>
