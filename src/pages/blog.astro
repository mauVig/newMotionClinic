---
import Layout from '@/layouts/Layout.astro';
import NavBarv2 from '@/components/NavBarv2.astro';
import Footer from '@/components/Footer.astro';
import ContentBlog from '@/components/blog/ContentBlog.astro';
import blogData from '@/data/blogData.json';

// El último blog agregado (el primero del array)
const latestBlog = blogData[0];
---

<Layout title={latestBlog.SEOtitle} description={latestBlog.metadescription}>
  <NavBarv2 tab="blog" />
  <ContentBlog blog={latestBlog} />
  <Footer contacto="no" />
</Layout>