---
import Layout from '@/layouts/Layout.astro';
import NavBarv2 from '@/components/NavBarv2.astro';
import Footer from '@/components/Footer.astro';
import ContentBlog from '@/components/blog/ContentBlog.astro';
import blogData from '@/data/blogData.json';
import { createBlogPostingSchema, createBreadcrumbSchema } from '@/schemas/blogPosting';
import ContactForm from '@/components/Contact';

export function getStaticPaths() {
  const generateSlug = (title: string) =>
    title.toLowerCase().normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .replace(/[^a-z0-9\s-]/g, "")
      .replace(/\s+/g, "-")
      .replace(/-+/g, "-")
      .trim();

  return blogData.map((blog) => ({
    params: { slug: generateSlug(blog.title) },
    props: { blog, slug: generateSlug(blog.title) },
  }));
}

const { blog, slug } = Astro.props;

const blogSchema = [
  createBlogPostingSchema(blog, slug),
  createBreadcrumbSchema(blog.title, slug),
];
---

<Layout
  title={blog.SEOtitle}
  description={blog.metadescription}
  image={blog.img}
  schema={blogSchema}
>
  <NavBarv2 tab="blog" />
  <ContentBlog blog={blog} />
  <ContactForm client:load contact/>
  <Footer contacto="no" />
</Layout>
