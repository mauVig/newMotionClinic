---
import Layout from '@/layouts/Layout.astro';
import NavBarv2 from '@/components/NavBarv2.astro';
import Footer from '@/components/Footer.astro';
import ContentBlog from '@/components/blog/ContentBlog.astro';
import blogData from '@/data/blogData.json';

export function getStaticPaths() {
  const generateSlug = (title: string) =>
    title.toLowerCase().normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .replace(/[^a-z0-9\s-]/g, "")
      .replace(/\s+/g, "-")
      .replace(/-+/g, "-")
      .trim();

  return blogData.map((blog) => ({
    params: { slug: generateSlug(blog.title) },
    props: { blog },
  }));
}

const { blog } = Astro.props;
---

<Layout title={blog.SEOtitle} description={blog.metadescription}>
  <NavBarv2 tab="blog" />
  <ContentBlog blog={blog} />
  <Footer contacto="no" />
</Layout>