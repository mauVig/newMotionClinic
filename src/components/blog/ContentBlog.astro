---
// ContentBlog.astro - sin React, HTML estático para SEO
import blogData from '@/data/blogData.json';

interface Props {
  blog: {
    id: number;
    title: string;
    date: string;
    img: string;
    develop: string;
    source?: string;
    SEOtitle: string;
    metadescription: string;
  };
}

const { blog } = Astro.props;

const generateSlug = (title: string) =>
  title.toLowerCase().normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-z0-9\s-]/g, "")
    .replace(/\s+/g, "-")
    .replace(/-+/g, "-")
    .trim();

const otherBlogs = blogData.filter((b) => b.title !== blog.title);

const sourceHostname = blog.source
  ? new URL(blog.source).hostname.replace("www.", "")
  : null;
---

<div class="min-h-screen bg-[#111] text-white">
  <div class="container mx-auto px-6 pt-24 pb-16">

    <div class="flex gap-8 items-start flex-col xl:flex-row">

      <!-- Imagen -->
      <div class="flex-shrink-0 w-full xl:w-1/2 xl:sticky top-24 self-start">
        <h1 class="xl:hidden text-4xl xl:text-5xl font-black text-white leading-tight mb-4 border-l-4 border-[#5b25d4] pl-4 drop-shadow-lg">
          {blog.title}
        </h1>
        <div class="transition-transform duration-300">
          <img
            src={blog.img}
            alt={blog.title}
            class="w-full h-[320px] sm:h-[420px] md:h-[480px] lg:h-[520px] object-cover rounded-lg"
          />
        </div>
      </div>

      <!-- Contenido -->
      <div class="flex-1">
        <header class="mb-6">
          <div class="flex items-center gap-6 text-sm text-gray-400 mb-6 pb-4">
            <span class="flex items-center gap-2">
              <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"/>
              </svg>
              <span>{blog.date}</span>
            </span>
          </div>
          <h1 class="hidden xl:block text-4xl xl:text-5xl font-black text-white leading-tight mb-4 border-l-4 border-[#5b25d4] pl-4 drop-shadow-lg">
            {blog.title}
          </h1>
        </header>

        <!-- Contenido del artículo — HTML estático para SEO -->
        <article class="text-xl space-y-6">
          <div set:html={blog.develop} />

          {sourceHostname && (
            <div class="mt-8 pt-6">
              <div class="flex items-center gap-3 text-sm text-gray-400">
                <span class="font-medium text-gray-300">Fuente:</span>
                <a
                  href={blog.source}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="relative inline-flex items-center justify-center
                         px-[clamp(1.5rem,3vw,2.5rem)] py-[clamp(0.3rem,0.6vw,0.5rem)]
                         rounded-[0.7rem] font-semibold text-[clamp(0.8rem,1vw,1rem)]
                         uppercase tracking-wide text-white bg-transparent border border-[#5b25d4]
                         overflow-hidden group
                         hover:bg-[#5b25d4]/10 hover:shadow-[0_0_25px_rgba(91,37,212,0.5)]
                         active:scale-[0.97] transition-all duration-300"
                >
                  <span class="relative z-10 transition-transform duration-300 group-hover:scale-105">
                    {sourceHostname}
                  </span>
                  <span class="absolute inset-0 bg-gradient-to-r from-[#5b25d4] to-[#8b5cf6]
                               opacity-0 group-hover:opacity-100 transition-opacity duration-500
                               rounded-[0.7rem]" />
                </a>
              </div>
            </div>
          )}
        </article>
      </div>
    </div>

    <!-- Otras noticias -->
    <section class="mt-16 border-t border-gray-700 pt-12">
      <div class="mb-8 border-l-4 border-[#5b25d4]">
        <h2 class="text-3xl font-bold text-white pl-4 mb-2">Blog de noticias</h2>
        <p class="text-gray-400 ml-4">Mantente informado con las últimas novedades de Motion Clinic</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {otherBlogs.map((blogItem) => (
          <article class="group cursor-pointer transition-all duration-300 hover:bg-violet/10 p-4 rounded-lg">
            <a href={`/blog/${generateSlug(blogItem.title)}`} class="block">
              <div class="relative overflow-hidden rounded-lg mb-4">
                <img
                  src={blogItem.img}
                  alt={blogItem.title}
                  class="w-full h-48 object-cover transition-transform duration-300 group-hover:scale-110"
                  loading="lazy"
                />
              </div>
              <div>
                <h3 class="h-14 text-xl font-bold text-white mb-2 group-hover:text-purple transition-colors">
                  {blogItem.title}
                </h3>
                <p class="text-gray-400 text-sm leading-relaxed">
                  {blogItem.develop.substring(0, 210)}...
                </p>
              </div>
            </a>
          </article>
        ))}
      </div>
    </section>

  </div>
</div>