---
// Experience.astro - GSAP vanilla, sin React
const targetYears = new Date().getFullYear() - 2009;
---

<section
  id="experience"
  class="relative w-full min-h-[180vh] bg-[#111] text-white overflow-visible"
>

  <!-- Texto sticky centrado -->
  <div class="sticky top-0 flex flex-col items-center justify-center text-center h-screen px-6 z-20">
    <div class="experience-text max-w-[700px] mx-auto">

      <h2 class="font-bold tracking-tight leading-[0.9] uppercase"
          style="font-size: clamp(3rem,7vw,4.5rem)">
        <span id="years-counter">0</span>
        <!-- SEO: valor real invisible para crawlers -->
        <span class="absolute invisible">{targetYears}</span>

        <span class="block mt-2">Años de</span>
        <span class="block text-[#835bff] italic font-bold">Experiencia</span>
      </h2>

      <p class="mt-8 text-white/70 leading-relaxed"
         style="font-size: clamp(1.05rem,1.6vw,1.3rem)">
        Logramos resultados funcionales y personalizados, específicamente diseñados para cada paciente.
      </p>

    </div>
  </div>

  <!-- Imágenes flotantes con parallax -->
  <div class="absolute inset-0 pointer-events-none z-10">

    <div
      id="exp-img-0"
      class="absolute top-[4vh] right-[6vw] w-[52vw] max-w-[280px] md:w-[32vw] md:max-w-[340px] rounded-2xl overflow-hidden shadow-xl"
    >
      <img
        src="/img/clinic-cell.webp"
        alt="Clínica de Rehabilitación en Buenos Aires"
        class="w-full h-auto object-cover"
      />
    </div>

    <div
      id="exp-img-1"
      class="absolute top-[80vh] left-[10vw] w-[50vw] max-w-[270px] md:w-[30vw] md:max-w-[330px] rounded-2xl overflow-hidden shadow-xl"
    >
      <img
        src="/img/clinic2-cell.webp"
        alt="Médico revisando estudios de rodilla"
        class="w-full h-auto object-cover"
      />
    </div>

    <div
      id="exp-img-2"
      class="absolute top-[150vh] right-[10vw] w-[48vw] max-w-[260px] md:w-[28vw] md:max-w-[320px] rounded-2xl overflow-hidden shadow-xl"
    >
      <img
        src="/img/clinic3-cell.webp"
        alt="Andrés Anania, cirujano ortopedista especializado"
        class="w-full h-auto object-cover"
      />
    </div>

    <div
      id="exp-img-3"
      class="absolute top-[200vh] left-[8vw] w-[50vw] max-w-[270px] md:w-[30vw] md:max-w-[330px] rounded-2xl overflow-hidden shadow-xl"
    >
      <img
        src="/img/clinic4-cell.webp"
        alt="Andrés Anania, trabajando en su centro"
        class="w-full h-auto object-cover"
      />
    </div>

  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const section = document.getElementById("experience") as HTMLElement;
  const counter = document.getElementById("years-counter") as HTMLElement;
  const targetYears = new Date().getFullYear() - 2009;

  const cards = [
    document.getElementById("exp-img-0"),
    document.getElementById("exp-img-1"),
    document.getElementById("exp-img-2"),
    document.getElementById("exp-img-3"),
  ] as HTMLDivElement[];

  const isMobile = window.innerWidth < 768;
  const depths = isMobile ? [80, 120, 160, 200] : [120, 200, 280, 360];
  const dirs   = [1, -1, 1, -1];

  // ── Refresh inicial ─────────────────────────────────────────────────────────
  setTimeout(() => ScrollTrigger.refresh(), 120);

  // ── Texto intro ─────────────────────────────────────────────────────────────
  gsap.fromTo(
    ".experience-text",
    { autoAlpha: 0, y: 50, filter: "blur(18px)" },
    {
      autoAlpha: 1,
      y: 0,
      filter: "blur(0px)",
      duration: 1.5,
      ease: "power4.out",
      scrollTrigger: {
        trigger: section,
        start: "top 80%",
        once: true,
      },
    }
  );

  // ── Contador de años ────────────────────────────────────────────────────────
  ScrollTrigger.create({
    trigger: section,
    start: "top 70%",
    onEnter: () => {
      const obj = { value: 0 };
      gsap.to(obj, {
        value: targetYears,
        duration: 2,
        ease: "power3.out",
        onUpdate: () => {
          counter.textContent = "+" + Math.round(obj.value);
        },
      });
    },
  });

  // ── Entrada de imágenes ─────────────────────────────────────────────────────
  const state = cards.map((_, i) => ({
    current: 0,
    target: 0,
    depth: depths[i],
    dir: dirs[i],
  }));

  cards.forEach((card, i) => {
    gsap.set(card, { y: -60 * state[i].dir, opacity: 0, scale: 0.85 });
    gsap.to(card, {
      opacity: 1,
      scale: 1,
      duration: 1.5,
      ease: "expo.out",
      delay: 0.15 * i,
      scrollTrigger: {
        trigger: section,
        start: "top 95%",
        once: true,
      },
    });
  });

  // ── Parallax principal ──────────────────────────────────────────────────────
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

  ScrollTrigger.create({
    trigger: section,
    start: "top bottom",
    end: "bottom top",
    scrub: 1.6,
    onUpdate: (self) => {
      const p = (self.progress - 0.5) * 2;
      state.forEach((s) => (s.target = p * s.depth * s.dir));
    },
  });

  gsap.ticker.add(() => {
    state.forEach((s, i) => {
      s.current = lerp(s.current, s.target, isMobile ? 0.1 : 0.12);
      gsap.set(cards[i], { y: s.current });
    });
  });
</script>