---
// Objective.astro - texto estático en HTML, JS solo anima
const fullText = "Nuestro objetivo es ayudarte a recuperar tu calidad de vida. Estamos acá para que sigas haciendo lo que más te gusta y sigas intentando superarte. Con años de experiencia y las técnicas más avanzadas, nos aseguramos que tu cirugía sea un éxito y tu recuperación sea lo más rápida posible.";

const words = fullText.split(" ");
const chars = "DO IT AGAIN".split("");
---

<section
  id="reveal-section"
  class="relative min-h-[120vh] flex flex-col items-center justify-center px-4 bg-[#111] text-white will-change-transform"
>
  <div class="flex flex-col items-center justify-center text-center space-y-4 sm:space-y-32 md:space-y-40">

    <!-- ShinyText: palabras en HTML estático para SEO -->
    <div
      id="shiny-container"
      class="inline-block text-center text-[#6e6e6ea4] max-w-screen-lg"
    >
      <p class="text-center block text-xl sm:text-2xl lg:text-4xl leading-relaxed">
        {words.map((word) => (
          <><span class="shiny-word inline-block will-change-transform">{word}</span>{" "}</>
        ))}
      </p>
    </div>

    <!-- DO IT AGAIN: chars en HTML estático para SEO -->
    <div
      id="objective-text"
      class="leading-[1.05] font-bold italic text-white reddit-sans-text max-w-[92vw] mx-auto pr-[0.35em] text-5xl tracking-[-0.02em] sm:text-4xl sm:tracking-tight md:text-7xl lg:text-[9rem] pb-32 pt-20 will-change-transform"
    >
      {chars.map((char) => (
        <span class="char inline-block will-change-transform">
          <span class="char-inner inline-block will-change-transform">
            {char === " " ? "\u00A0" : char}
          </span>
        </span>
      ))}
    </div>

  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // ── ShinyText ───────────────────────────────────────────────────────────────
  const shinyContainer = document.getElementById("shiny-container") as HTMLElement;
  const wordSpans = shinyContainer.querySelectorAll(".shiny-word");

  gsap.set(wordSpans, {
    color: "#6e6e6ea4",
    filter: "blur(6px)",
    opacity: 0.2,
  });

  gsap.timeline({
    scrollTrigger: {
      trigger: shinyContainer,
      start: "top 90%",
      end: "bottom top",
      scrub: 2.5,
      anticipatePin: 1,
    },
  }).to(wordSpans, {
    color: "#cfb1fb",
    opacity: 1,
    filter: "blur(0px)",
    stagger: { each: 0.55, ease: "power2.out" },
    duration: 2.4,
    ease: "power3.out",
  });

  // ── DO IT AGAIN ─────────────────────────────────────────────────────────────
  const section = document.getElementById("reveal-section") as HTMLElement;
  const charSpans = section.querySelectorAll(".char-inner");

  gsap.set(charSpans, {
    yPercent: 110,
    opacity: 0,
    filter: "blur(12px)",
  });

  gsap.timeline({
    scrollTrigger: {
      trigger: section,
      start: "top top",
      end: "+=200%",
      scrub: 2,
      pin: true,
      anticipatePin: 1,
    },
    defaults: { ease: "power3.out" },
  })
  .to(charSpans, {
    yPercent: 0,
    opacity: 1,
    filter: "blur(0px)",
    stagger: 0.06,
    duration: 1.6,
  })
  .to(charSpans, {
    yPercent: -40,
    opacity: 0.2,
    duration: 2,
    ease: "power2.inOut",
    stagger: 0.04,
  });

  window.addEventListener("load", () => {
    setTimeout(() => ScrollTrigger.refresh(), 300);
  });
</script>