---
// ClinicTestify.astro - GSAP vanilla, sin React
---

<section
  id="studio"
  class="w-full flex flex-col items-center bg-[#111] text-white py-[12vh]"
>
  <div class="w-full max-w-[950px] flex flex-col gap-8">

    <!-- HEADER -->
    <div id="clinic-title" class="flex flex-col gap-2">
      <p class="text-sm tracking-[0.22em] text-white/60 uppercase">
        Motion Clinic
      </p>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight leading-[0.9]">
        Ubicación
      </h2>
    </div>

    <!-- MAPA -->
    <div
      id="clinic-map"
      class="relative w-full h-[320px] sm:h-[420px] md:h-[520px] lg:h-[560px] rounded-3xl overflow-hidden bg-[#1a1a1a] border border-white/10 shadow-[0_10px_40px_rgba(0,0,0,0.45)] backdrop-blur-xl will-change-transform"
    >
      <iframe
        class="absolute inset-0 w-full h-full"
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3285.5261873764753!2d-58.43667917068962!3d-34.56555015989195!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x95bcb5b97072cbb1%3A0xfec53bcc88faa676!2sMaure%201608%2C%20C1426CUD%20Cdad.%20Aut%C3%B3noma%20de%20Buenos%20Aires!5e0!3m2!1ses-419!2sar!4v1757915667649!5m2!1ses-419!2sar"
        loading="lazy"
        style="border: 0;"
        title="Mapa de la clínica de rehabilitación en Buenos Aires"
      ></iframe>
    </div>

    <!-- DIRECCIÓN -->
    <div id="clinic-info" class="flex flex-col gap-4">
      <div style="padding-top: 30px;">
        <p class="text-sm sm:text-base font-medium">Maure 1608</p>
        <p class="text-xs sm:text-sm text-white/60">
          C1426CUD · Ciudad Autónoma de Buenos Aires · Argentina
        </p>
      </div>

      <a
        href="https://www.google.com/maps/place/Maure+1608,+C1426CUD+Cdad.+Aut%C3%B3noma+de+Buenos+Aires/"
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs sm:text-sm tracking-[0.18em] uppercase text-white/60 hover:text-white flex items-center gap-2"
      >
        <span>Abrir en Google Maps</span>
        <span class="text-lg -translate-y-[1px]">↗</span>
      </a>
    </div>

  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const section = document.getElementById("studio") as HTMLElement;
  const title   = document.getElementById("clinic-title") as HTMLElement;
  const map     = document.getElementById("clinic-map") as HTMLElement;
  const info    = document.getElementById("clinic-info") as HTMLElement;

  // ── Animación de entrada ────────────────────────────────────────────────────
  const tl = gsap.timeline({
    scrollTrigger: { trigger: section, start: "top 75%", once: true },
  });

  tl.fromTo(section,
    { opacity: 0, y: 120, filter: "blur(30px)" },
    { opacity: 1, y: 0,   filter: "blur(0px)", duration: 1.6, ease: "power4.out" }
  )
  .fromTo(title.children,
    { opacity: 0, y: 40,  filter: "blur(18px)" },
    { opacity: 1, y: 0,   filter: "blur(0px)", duration: 1.4, ease: "power4.out", stagger: 0.12 },
    "-=1.1"
  )
  .fromTo(map,
    { clipPath: "inset(0 100% 0 0)", opacity: 0, scale: 1.08, filter: "blur(26px)", y: 40 },
    { clipPath: "inset(0 0% 0 0)",   opacity: 1, scale: 1,    filter: "blur(0px)",  y: 0, duration: 1.8, ease: "power4.out" },
    "-=0.9"
  )
  .fromTo(info.children,
    { opacity: 0, y: 20,  filter: "blur(14px)" },
    { opacity: 1, y: 0,   filter: "blur(0px)", duration: 1.3, ease: "power3.out", stagger: 0.18 },
    "-=0.9"
  );

  // ── Micro parallax (respiración) ────────────────────────────────────────────
  gsap.to(map, {
    y: "+=6",
    duration: 3,
    ease: "none",
    repeat: -1,
    yoyo: true,
  });

  // ── Tilt 3D en desktop ──────────────────────────────────────────────────────
  const isMobile = window.matchMedia("(max-width: 768px)").matches;

  if (!isMobile) {
    map.addEventListener("mousemove", (e: MouseEvent) => {
      const rect  = map.getBoundingClientRect();
      const midX  = rect.width / 2;
      const midY  = rect.height / 2;
      const rotateY =  ((e.clientX - rect.left - midX) / midX) * 7;
      const rotateX = -((e.clientY - rect.top  - midY) / midY) * 7;

      gsap.to(map, {
        rotateY,
        rotateX,
        transformPerspective: 800,
        duration: 0.4,
        ease: "power3.out",
      });
    });

    map.addEventListener("mouseleave", () => {
      gsap.to(map, {
        rotateX: 0,
        rotateY: 0,
        duration: 0.6,
        ease: "elastic.out(1, 0.5)",
      });
    });
  }
</script>